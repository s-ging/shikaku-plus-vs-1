// Cloudflare config for the Shikaku+ VS playtest. Deploy guide: DEPLOY.md.
{
	"name": "shikaku-plus-vs-1",
	"main": "worker/index.js",
	"compatibility_date": "2025-09-01",
	// Wrangler runs this before every deploy and dev, so public/ always exists,
	// including on Cloudflare's own Git builds (Workers Builds).
	"build": { "command": "node build.mjs" },
	// The client is plain static files. Unknown paths such as /QWER serve index.html.
	// Only /ws/* and /api/* reach the Worker, so loading the page costs no Worker time.
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/ws/*", "/api/*"]
	},
	"durable_objects": {
		"bindings": [
			{ "name": "ROOMS", "class_name": "Room" },
			{ "name": "REPORTS", "class_name": "Reports" }
		]
	},
	"previews": {
	},
	// The Casual queues live in their own Worker (matchmaker/, decision 0025) so tuning them never
	// restarts the rooms. Off until that Worker exists (2026-11-14: a binding to a missing Worker fails
	// the whole deploy). To switch on: npm run deploy:mm, then uncomment this line and remove `hidden`
	// from the Casual panel in client/index.html (DEPLOY.md, "Matchmaking").
	// "services": [{ "binding": "MM", "service": "shikaku-plus-mm" }],
	// Account checks for signed-in players (worker/identity.js, decision 0017). Both are public by
	// design: the same URL and anon key ship inside every Shikaku+ app build. Remove them and
	// everyone simply joins as a guest.
	"vars": {
		"SUPABASE_URL": "https://facboumzeprcfzfhchnq.supabase.co",
		"SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImZhY2JvdW16ZXByY2Z6ZmhjaG5xIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODAzMTUwODUsImV4cCI6MjA5NTg5MTA4NX0.I_lxa8Dh2_bBdqeZ-PtzWj7wR2l7GTcp0rNDb84qq-w"
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["Room", "Reports"] }]
	// The admin secret is NOT here. Set it once with: npx wrangler secret put ADMIN_KEY
}

